  "_coupling_mechanics": {
    "framework": "Smithson 8S Coupled Mechanics v1.0",
    "status": "Proposed generative and computational law; not an established physical law, not the standard sphere S^8 without separate topological proof, and not evidence of physical quantum entanglement.",
    "author": "Russell Philip Smithson",
    "analytical_support_layers": [
      "SOPHIA",
      "CHARLOTTE",
      "LANDON"
    ],
    "canonical_terms": {
      "object": "S^3 fiber",
      "base": "five-dimensional penteract field B^5=[-1,1]^5",
      "hidden_center": "latent five-dimensional center",
      "fifth_coordinate": "elucidation coordinate t8 with declared independent semantic or mechanical meaning",
      "visible_center": "projected center",
      "pairwise_interaction": "sparse geometric-semantic classical coupling",
      "higher_order_interaction": "selective triadic coupling",
      "visual_overlap": "projected three-dimensional overlap",
      "total_space": "locally eight-dimensional noncollapsed penteract-S^3 hyperfiber system"
    },
    "equations": {
      "coordinate_extension": "C5=[C4|e]",
      "independent_residual": "e_perp=(I-C4*C4^+)e",
      "independence_score": "eta_ind=||e_perp||_2^2/(||e||_2^2+epsilon)",
      "driver": "q(tau)=sin^2(pi*tau/T)",
      "candidate_site": "c_n=ell*n, n in Z^5, ||n||_1<=M",
      "shell_multiplicity": "A_5(m)=sum_{j=1}^{min(5,m)} 2^j*C(5,j)*C(m-1,j-1); A_5(0)=1",
      "coupling_weight": "W_ij=A_ij*exp(-((c_i-c_j)^T G5 (c_i-c_j))/(2 sigma_c^2)-d_J(i,j)^2/(2 sigma_J^2))",
      "phase_dynamics": "dtheta_i/dtau=omega_i+K2*sum_j W_ij*sin(theta_j-theta_i)+K3*sum_{j,k} H_ijk*sin(theta_j+theta_k-2theta_i)",
      "activation_score": "h_i=beta(Mq+1/2-d_i)+a_E E_i+a_u u_i-a_chi chi_i-a_zeta zeta_i+J2*sum_j W_ij(2p_j-1)+J3*sum_{j,k} H_ijk(2p_j-1)(2p_k-1)",
      "activation": "p_i=sigma(h_i)=1/(1+exp(-h_i))",
      "smooth_boundary": "B_5,infinity(c_i)=prod_{a=4}^{8} b(c_{i,a})",
      "effective_support": "s_i=p_i*kappa_i*(1-chi_i)*(1-zeta_i)*v(omega_i)",
      "radius": "r_i=r_max*B_5,infinity(c_i)^alpha*s_i^(1/3)",
      "fiber": "F_i=S^3_{r_i}={y in R^4: ||y||_2=r_i}",
      "fiber_volume": "Vol(S^3_{r_i})=2*pi^2*r_max^3*B_5,infinity(c_i)^(3alpha)*s_i",
      "total_space": "X8(tau)={(c,y) in [-1,1]^5 x R^4: ||y||_2=R(c,tau)}",
      "full_projection": "x_i^(3)(u,tau)=[Pi5(tau)|Psi4(tau)]*[c_i;r_i*u], u in S^3",
      "latent_5d_gap": "g5_ij=sqrt((c_i-c_j)^T G5 (c_i-c_j))-(lambda_i+lambda_j)",
      "product_state_separation": "delta8_ij=sqrt((c_i-c_j)^T G5 (c_i-c_j)+(r_i-r_j)^2)",
      "projected_gap": "g3_ij=||Pi5*c_i-Pi5*c_j||_2-(rhat_i+rhat_j)",
      "semantic_gap": "gJ_ij=d_J(J_i,J_j)-theta_J",
      "efficacy_gain": "Delta_8S=Score(M8)-Score(M7)",
      "admission_gate": "Admit(8S) iff eta_ind>=epsilon_ind and Delta_8S>epsilon_gain"
    },
    "relation_test": {
      "inputs": [
        "g5_ij",
        "delta8_ij",
        "g3_ij",
        "gJ_ij",
        "K_ij",
        "Sigma_ij"
      ],
      "classification_order": [
        "UNRESOLVED when an uncertainty interval crosses a declared tolerance or required evidence/provenance is missing",
        "CONTRADICTION when K_ij>=theta_K",
