deepml vfx 0.3
module corpus.deepml_vfx.example_02609
policy deterministic
policy no_network
effect Effect02609 {
  coupled simulation PortalSim seed 2609 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache2 interval 0s..10s step 1/60s hash sha256("cache:02609")
  bind scene PortalScene8
  bind timeline PortalSequence9
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
