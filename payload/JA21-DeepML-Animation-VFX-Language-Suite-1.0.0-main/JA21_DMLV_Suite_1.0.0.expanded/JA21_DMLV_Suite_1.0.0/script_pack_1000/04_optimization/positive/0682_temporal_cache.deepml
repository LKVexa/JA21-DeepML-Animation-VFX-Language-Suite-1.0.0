deepml vfx 0.3
module corpus.deepml_vfx.example_02617
policy deterministic
policy no_network
effect Effect02617 {
  coupled simulation PortalSim seed 2617 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache10 interval 0s..10s step 1/60s hash sha256("cache:02617")
  bind scene PortalScene16
  bind timeline PortalSequence4
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
