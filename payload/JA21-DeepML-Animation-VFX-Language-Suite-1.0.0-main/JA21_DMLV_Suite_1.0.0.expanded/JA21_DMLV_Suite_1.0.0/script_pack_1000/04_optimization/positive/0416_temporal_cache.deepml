deepml vfx 0.3
module corpus.deepml_vfx.example_02569
policy deterministic
policy no_network
effect Effect02569 {
  coupled simulation PortalSim seed 2569 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache6 interval 0s..10s step 1/60s hash sha256("cache:02569")
  bind scene PortalScene2
  bind timeline PortalSequence8
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
