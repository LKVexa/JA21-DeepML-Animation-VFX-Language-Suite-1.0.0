deepml vfx 0.3
module corpus.deepml_vfx.example_02549
policy deterministic
policy no_network
effect Effect02549 {
  coupled simulation PortalSim seed 2549 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache8 interval 0s..10s step 1/60s hash sha256("cache:02549")
  bind scene PortalScene16
  bind timeline PortalSequence1
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
