deepml vfx 0.3
module corpus.deepml_vfx.example_02641
policy deterministic
policy no_network
effect Effect02641 {
  coupled simulation PortalSim seed 2641 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache1 interval 0s..10s step 1/60s hash sha256("cache:02641")
  bind scene PortalScene6
  bind timeline PortalSequence2
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
