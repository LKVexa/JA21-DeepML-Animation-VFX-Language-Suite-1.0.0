deepml vfx 0.3
module corpus.deepml_vfx.example_02519
policy deterministic
policy no_network
effect Effect02519 {
  coupled simulation PortalSim seed 2519 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache0 interval 0s..10s step 1/60s hash sha256("cache:02519")
  bind scene PortalScene3
  bind timeline PortalSequence10
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
