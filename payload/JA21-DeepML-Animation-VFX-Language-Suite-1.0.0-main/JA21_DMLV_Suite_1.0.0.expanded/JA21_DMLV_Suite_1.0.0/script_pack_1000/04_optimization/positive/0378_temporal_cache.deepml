deepml vfx 0.3
module corpus.deepml_vfx.example_02563
policy deterministic
policy no_network
effect Effect02563 {
  coupled simulation PortalSim seed 2563 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache0 interval 0s..10s step 1/60s hash sha256("cache:02563")
  bind scene PortalScene13
  bind timeline PortalSequence2
  render_graph { Sim -> Lighting -> Distortion -> Composite }
