deepml vfx 0.3
module corpus.deepml_vfx.example_02611
policy deterministic
policy no_network
effect Effect02611 {
  coupled simulation PortalSim seed 2611 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache4 interval 0s..10s step 1/60s hash sha256("cache:02611")
  bind scene PortalScene10
  bind timeline PortalSequence11
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
