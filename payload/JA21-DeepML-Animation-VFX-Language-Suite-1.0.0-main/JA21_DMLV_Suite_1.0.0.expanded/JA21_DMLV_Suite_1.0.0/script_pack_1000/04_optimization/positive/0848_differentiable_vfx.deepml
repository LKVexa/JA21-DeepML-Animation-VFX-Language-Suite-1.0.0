deepml vfx 0.3
module corpus.deepml_vfx.example_02663
policy deterministic
policy no_network
effect Effect02663 {
  coupled simulation PortalSim seed 2663 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache1 interval 0s..10s step 1/60s hash sha256("cache:02663")
  bind scene PortalScene11
  bind timeline PortalSequence11
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
