deepml vfx 0.3
module corpus.deepml_vfx.example_02509
policy deterministic
policy no_network
effect Effect02509 {
  coupled simulation PortalSim seed 2509 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache1 interval 0s..10s step 1/60s hash sha256("cache:02509")
  bind scene PortalScene10
  bind timeline PortalSequence0
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
