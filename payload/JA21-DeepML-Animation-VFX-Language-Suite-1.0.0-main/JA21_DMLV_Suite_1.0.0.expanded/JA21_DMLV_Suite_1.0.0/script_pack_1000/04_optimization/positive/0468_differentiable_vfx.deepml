deepml vfx 0.3
module corpus.deepml_vfx.example_02597
policy deterministic
policy no_network
effect Effect02597 {
  coupled simulation PortalSim seed 2597 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache1 interval 0s..10s step 1/60s hash sha256("cache:02597")
  bind scene PortalScene13
  bind timeline PortalSequence10
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
