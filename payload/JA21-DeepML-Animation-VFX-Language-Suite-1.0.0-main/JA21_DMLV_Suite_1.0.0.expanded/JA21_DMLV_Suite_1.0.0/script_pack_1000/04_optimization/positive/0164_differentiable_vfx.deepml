deepml vfx 0.3
module corpus.deepml_vfx.example_02531
policy deterministic
policy no_network
effect Effect02531 {
  coupled simulation PortalSim seed 2531 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache1 interval 0s..10s step 1/60s hash sha256("cache:02531")
  bind scene PortalScene15
  bind timeline PortalSequence9
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
