deepml vfx 0.3
module corpus.deepml_vfx.example_02593
policy deterministic
policy no_network
effect Effect02593 {
  coupled simulation PortalSim seed 2593 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache8 interval 0s..10s step 1/60s hash sha256("cache:02593")
  bind scene PortalScene9
  bind timeline PortalSequence6
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
