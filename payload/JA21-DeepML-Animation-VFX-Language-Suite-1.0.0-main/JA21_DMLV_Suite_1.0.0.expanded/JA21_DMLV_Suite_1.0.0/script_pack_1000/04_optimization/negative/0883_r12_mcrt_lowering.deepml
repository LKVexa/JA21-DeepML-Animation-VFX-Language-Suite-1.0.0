deepml vfx 0.3
module corpus.deepml_vfx.example_07526
policy deterministic
policy no_network
render_graph Effect07526 {
  pass A { shader: Shared inputs: [Position, Velocity] }
  pass B { shader: Shared inputs: [Position, Velocity] }
  pass Dead enabled false
  cache C frames 0..110
  domain Sim tiles [4,4,3]
}
optimize Effect07526 using [node_fusion, dead_pass_removal, attribute_packing, shader_specialization, cache_scheduling, domain_tiling, render_graph_ordering]
lower Effect07526 to DEEPML_VFX_R12
assert render_hash == "invalid-07526"
