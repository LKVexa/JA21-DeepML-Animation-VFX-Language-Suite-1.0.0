deepml vfx 0.3
module corpus.deepml_vfx.example_02513
policy deterministic
policy no_network
effect Effect02513 {
  coupled simulation PortalSim seed 2513 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache5 interval 0s..10s step 1/60s hash sha256("cache:02513")
  bind scene PortalScene14
  bind timeline PortalSequence4
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
assert render_hash == "invalid-02513"
