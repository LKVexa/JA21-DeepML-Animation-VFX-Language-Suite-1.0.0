deepml vfx 0.3
module corpus.deepml_vfx.example_02521
policy deterministic
policy no_network
effect Effect02521 {
  coupled simulation PortalSim seed 2521 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache2 interval 0s..10s step 1/60s hash sha256("cache:02521")
  bind scene PortalScene5
  bind timeline PortalSequence12
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
assert render_hash == "invalid-02521"
