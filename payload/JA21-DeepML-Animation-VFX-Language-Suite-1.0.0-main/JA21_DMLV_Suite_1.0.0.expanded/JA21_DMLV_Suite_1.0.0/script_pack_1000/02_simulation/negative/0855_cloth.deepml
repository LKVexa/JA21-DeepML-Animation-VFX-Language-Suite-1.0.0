deepml vfx 0.3
module corpus.deepml_vfx.example_01051
policy deterministic
policy no_network
effect Effect01051 {
  fluid Smoke { grid: [123,123,59] solver: stable_fluids }
  cloth Banner { resolution: [43,43] stiffness: 0.3 }
  destruction Debris { pieces: 35 fracture: voronoi seed: 1051 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.4 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
assert render_hash == "invalid-01051"
