deepml vfx 0.3
module corpus.deepml_vfx.example_01032
policy deterministic
policy no_network
effect Effect01032 {
  fluid Smoke { grid: [104,104,40] solver: stable_fluids }
  cloth Banner { resolution: [24,24] stiffness: 0.5 }
  destruction Debris { pieces: 16 fracture: voronoi seed: 1032 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.1 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
assert render_hash == "invalid-01032"
