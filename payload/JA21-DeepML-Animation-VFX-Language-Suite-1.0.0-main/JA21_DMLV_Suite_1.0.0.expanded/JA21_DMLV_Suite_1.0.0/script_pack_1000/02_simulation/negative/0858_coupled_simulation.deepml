deepml vfx 0.3
module corpus.deepml_vfx.example_02529
policy deterministic
policy no_network
effect Effect02529 {
  coupled simulation PortalSim seed 2529 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache10 interval 0s..10s step 1/60s hash sha256("cache:02529")
  bind scene PortalScene13
  bind timeline PortalSequence7
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
assert render_hash == "invalid-02529"
