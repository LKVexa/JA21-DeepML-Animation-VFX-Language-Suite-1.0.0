deepml vfx 0.3
module corpus.deepml_vfx.example_01013
policy deterministic
policy no_network
effect Effect01013 {
  fluid Smoke { grid: [85,85,21] solver: stable_fluids }
  cloth Banner { resolution: [37,37] stiffness: 0.7 }
  destruction Debris { pieces: 61 fracture: voronoi seed: 1013 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.6 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
assert render_hash == "invalid-01013"
