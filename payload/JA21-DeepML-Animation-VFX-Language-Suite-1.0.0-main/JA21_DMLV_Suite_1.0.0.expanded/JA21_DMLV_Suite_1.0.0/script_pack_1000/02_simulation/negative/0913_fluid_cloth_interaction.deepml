deepml vfx 0.3
module corpus.deepml_vfx.example_05107
policy deterministic
policy no_network
vfx_package Effect05107 {
  weather system Weather4 { wind: vec3(2,0,1) rain: 707/s }
  destruction sequence Collapse2 bind timeline.Destruction
  interaction fluid Smoke with cloth Banner collision two_way
  portal effect Portal4 { particles: Sparks volumetric: Fog shader: Distortion }
  lighting pipeline { key: Sun fill: PortalGlow exposure: auto_deterministic }
  compositing pipeline { passes: [Scene, Weather, Portal, Grade] }
}
package vfx Effect05107 as "vfx_05107.msslb"
assert render_hash == "invalid-05107"
