deepml vfx 0.3
module corpus.deepml_vfx.example_01060
policy deterministic
policy no_network
effect Effect01060 {
  fluid Smoke { grid: [36,36,20] solver: stable_fluids }
  cloth Banner { resolution: [20,20] stiffness: 0.5 }
  destruction Debris { pieces: 44 fracture: voronoi seed: 1060 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.5 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
