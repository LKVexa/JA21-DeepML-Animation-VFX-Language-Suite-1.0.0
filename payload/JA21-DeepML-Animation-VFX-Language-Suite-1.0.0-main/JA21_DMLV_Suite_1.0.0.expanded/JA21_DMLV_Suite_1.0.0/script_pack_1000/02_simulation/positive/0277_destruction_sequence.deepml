deepml vfx 0.3
module corpus.deepml_vfx.example_05048
policy deterministic
policy no_network
vfx_package Effect05048 {
  weather system Weather1 { wind: vec3(2,0,1) rain: 648/s }
  destruction sequence Collapse3 bind timeline.Destruction
  interaction fluid Smoke with cloth Banner collision two_way
  portal effect Portal8 { particles: Sparks volumetric: Fog shader: Distortion }
  lighting pipeline { key: Sun fill: PortalGlow exposure: auto_deterministic }
  compositing pipeline { passes: [Scene, Weather, Portal, Grade] }
}
package vfx Effect05048 as "vfx_05048.msslb"
