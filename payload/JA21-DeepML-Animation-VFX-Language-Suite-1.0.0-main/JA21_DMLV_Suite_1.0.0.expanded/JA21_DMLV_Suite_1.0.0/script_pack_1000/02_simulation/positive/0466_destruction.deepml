deepml vfx 0.3
module corpus.deepml_vfx.example_01176
policy deterministic
policy no_network
effect Effect01176 {
  fluid Smoke { grid: [56,56,40] solver: stable_fluids }
  cloth Banner { resolution: [40,40] stiffness: 0.2 }
  destruction Debris { pieces: 32 fracture: voronoi seed: 1176 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.1 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
