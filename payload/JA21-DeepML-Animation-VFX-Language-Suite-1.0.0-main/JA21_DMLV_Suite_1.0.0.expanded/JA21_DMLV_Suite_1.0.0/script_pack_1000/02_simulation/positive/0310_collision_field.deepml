deepml vfx 0.3
module corpus.deepml_vfx.example_01112
policy deterministic
policy no_network
effect Effect01112 {
  fluid Smoke { grid: [88,88,24] solver: stable_fluids }
  cloth Banner { resolution: [40,40] stiffness: 0.8 }
  destruction Debris { pieces: 32 fracture: voronoi seed: 1112 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.1 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
