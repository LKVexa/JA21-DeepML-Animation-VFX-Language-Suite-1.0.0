deepml vfx 0.3
module corpus.deepml_vfx.example_05090
policy deterministic
policy no_network
vfx_package Effect05090 {
  weather system Weather1 { wind: vec3(2,0,1) rain: 690/s }
  destruction sequence Collapse0 bind timeline.Destruction
  interaction fluid Smoke with cloth Banner collision two_way
  portal effect Portal5 { particles: Sparks volumetric: Fog shader: Distortion }
  lighting pipeline { key: Sun fill: PortalGlow exposure: auto_deterministic }
  compositing pipeline { passes: [Scene, Weather, Portal, Grade] }
}
package vfx Effect05090 as "vfx_05090.msslb"
