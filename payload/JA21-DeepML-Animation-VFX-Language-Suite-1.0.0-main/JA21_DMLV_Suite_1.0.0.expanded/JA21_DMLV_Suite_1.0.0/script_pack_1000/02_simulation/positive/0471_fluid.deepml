deepml vfx 0.3
module corpus.deepml_vfx.example_01115
policy deterministic
policy no_network
effect Effect01115 {
  fluid Smoke { grid: [91,91,27] solver: stable_fluids }
  cloth Banner { resolution: [43,43] stiffness: 0.4 }
  destruction Debris { pieces: 35 fracture: voronoi seed: 1115 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.4 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
