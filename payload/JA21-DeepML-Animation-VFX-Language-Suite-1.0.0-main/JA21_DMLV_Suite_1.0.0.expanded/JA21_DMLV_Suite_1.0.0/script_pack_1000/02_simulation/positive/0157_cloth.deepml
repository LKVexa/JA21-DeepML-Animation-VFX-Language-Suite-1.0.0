deepml vfx 0.3
module corpus.deepml_vfx.example_01042
policy deterministic
policy no_network
effect Effect01042 {
  fluid Smoke { grid: [114,114,50] solver: stable_fluids }
  cloth Banner { resolution: [34,34] stiffness: 0.8 }
  destruction Debris { pieces: 26 fracture: voronoi seed: 1042 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.3 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
