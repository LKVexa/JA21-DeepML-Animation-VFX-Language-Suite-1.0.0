deepml vfx 0.3
module corpus.deepml_vfx.example_01214
policy deterministic
policy no_network
effect Effect01214 {
  fluid Smoke { grid: [94,94,30] solver: stable_fluids }
  cloth Banner { resolution: [46,46] stiffness: 0.5 }
  destruction Debris { pieces: 70 fracture: voronoi seed: 1214 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.7 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
