deepml vfx 0.3
module corpus.deepml_vfx.example_01058
policy deterministic
policy no_network
effect Effect01058 {
  fluid Smoke { grid: [34,34,18] solver: stable_fluids }
  cloth Banner { resolution: [18,18] stiffness: 0.3 }
  destruction Debris { pieces: 42 fracture: voronoi seed: 1058 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.3 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
