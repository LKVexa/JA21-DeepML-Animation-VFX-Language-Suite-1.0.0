deepml vfx 0.3
module corpus.deepml_vfx.example_01149
policy deterministic
policy no_network
effect Effect01149 {
  fluid Smoke { grid: [125,125,61] solver: stable_fluids }
  cloth Banner { resolution: [45,45] stiffness: 0.3 }
  destruction Debris { pieces: 69 fracture: voronoi seed: 1149 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.6 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
