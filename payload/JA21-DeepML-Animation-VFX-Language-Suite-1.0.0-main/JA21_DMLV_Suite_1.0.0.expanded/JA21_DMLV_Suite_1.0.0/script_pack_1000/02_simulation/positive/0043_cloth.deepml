deepml vfx 0.3
module corpus.deepml_vfx.example_01015
policy deterministic
policy no_network
effect Effect01015 {
  fluid Smoke { grid: [87,87,23] solver: stable_fluids }
  cloth Banner { resolution: [39,39] stiffness: 0.2 }
  destruction Debris { pieces: 63 fracture: voronoi seed: 1015 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.8 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
