deepml vfx 0.3
module corpus.deepml_vfx.example_05115
policy deterministic
policy no_network
vfx_package Effect05115 {
  weather system Weather5 { wind: vec3(2,0,1) rain: 715/s }
  destruction sequence Collapse0 bind timeline.Destruction
  interaction fluid Smoke with cloth Banner collision two_way
  portal effect Portal3 { particles: Sparks volumetric: Fog shader: Distortion }
  lighting pipeline { key: Sun fill: PortalGlow exposure: auto_deterministic }
  compositing pipeline { passes: [Scene, Weather, Portal, Grade] }
}
package vfx Effect05115 as "vfx_05115.msslb"
