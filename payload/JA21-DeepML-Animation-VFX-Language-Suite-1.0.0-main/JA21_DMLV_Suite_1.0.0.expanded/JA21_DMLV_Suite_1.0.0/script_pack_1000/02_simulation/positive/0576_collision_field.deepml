deepml vfx 0.3
module corpus.deepml_vfx.example_01175
policy deterministic
policy no_network
effect Effect01175 {
  fluid Smoke { grid: [55,55,39] solver: stable_fluids }
  cloth Banner { resolution: [39,39] stiffness: 0.8 }
  destruction Debris { pieces: 31 fracture: voronoi seed: 1175 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.8 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
