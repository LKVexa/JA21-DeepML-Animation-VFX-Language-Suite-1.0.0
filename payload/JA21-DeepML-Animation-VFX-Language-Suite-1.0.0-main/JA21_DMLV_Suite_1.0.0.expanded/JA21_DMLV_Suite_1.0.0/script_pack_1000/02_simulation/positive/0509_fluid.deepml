deepml vfx 0.3
module corpus.deepml_vfx.example_01124
policy deterministic
policy no_network
effect Effect01124 {
  fluid Smoke { grid: [100,100,36] solver: stable_fluids }
  cloth Banner { resolution: [20,20] stiffness: 0.6 }
  destruction Debris { pieces: 44 fracture: voronoi seed: 1124 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.5 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
