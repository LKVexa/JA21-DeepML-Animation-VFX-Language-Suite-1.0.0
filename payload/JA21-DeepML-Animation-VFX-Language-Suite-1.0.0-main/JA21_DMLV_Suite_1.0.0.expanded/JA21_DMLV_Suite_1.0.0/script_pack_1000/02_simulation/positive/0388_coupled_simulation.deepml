deepml vfx 0.3
module corpus.deepml_vfx.example_02571
policy deterministic
policy no_network
effect Effect02571 {
  coupled simulation PortalSim seed 2571 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache8 interval 0s..10s step 1/60s hash sha256("cache:02571")
  bind scene PortalScene4
  bind timeline PortalSequence10
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
