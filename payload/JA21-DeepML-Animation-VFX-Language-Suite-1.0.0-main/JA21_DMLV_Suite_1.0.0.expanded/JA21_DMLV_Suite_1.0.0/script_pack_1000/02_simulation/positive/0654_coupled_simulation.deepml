deepml vfx 0.3
module corpus.deepml_vfx.example_02625
policy deterministic
policy no_network
effect Effect02625 {
  coupled simulation PortalSim seed 2625 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache7 interval 0s..10s step 1/60s hash sha256("cache:02625")
  bind scene PortalScene7
  bind timeline PortalSequence12
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
