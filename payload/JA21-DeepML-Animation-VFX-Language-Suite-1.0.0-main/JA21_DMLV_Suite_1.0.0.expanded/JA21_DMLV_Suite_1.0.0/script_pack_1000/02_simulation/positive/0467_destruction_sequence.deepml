deepml vfx 0.3
module corpus.deepml_vfx.example_05084
policy deterministic
policy no_network
vfx_package Effect05084 {
  weather system Weather2 { wind: vec3(2,0,1) rain: 684/s }
  destruction sequence Collapse4 bind timeline.Destruction
  interaction fluid Smoke with cloth Banner collision two_way
  portal effect Portal8 { particles: Sparks volumetric: Fog shader: Distortion }
  lighting pipeline { key: Sun fill: PortalGlow exposure: auto_deterministic }
  compositing pipeline { passes: [Scene, Weather, Portal, Grade] }
}
package vfx Effect05084 as "vfx_05084.msslb"
