deepml vfx 0.3
module corpus.deepml_vfx.example_01193
policy deterministic
policy no_network
effect Effect01193 {
  fluid Smoke { grid: [73,73,57] solver: stable_fluids }
  cloth Banner { resolution: [25,25] stiffness: 0.5 }
  destruction Debris { pieces: 49 fracture: voronoi seed: 1193 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.2 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
