deepml vfx 0.3
module corpus.deepml_vfx.example_01021
policy deterministic
policy no_network
effect Effect01021 {
  fluid Smoke { grid: [93,93,29] solver: stable_fluids }
  cloth Banner { resolution: [45,45] stiffness: 0.8 }
  destruction Debris { pieces: 69 fracture: voronoi seed: 1021 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.6 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
