deepml vfx 0.3
module corpus.deepml_vfx.example_02595
policy deterministic
policy no_network
effect Effect02595 {
  coupled simulation PortalSim seed 2595 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache10 interval 0s..10s step 1/60s hash sha256("cache:02595")
  bind scene PortalScene11
  bind timeline PortalSequence8
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
