deepml vfx 0.3
module corpus.deepml_vfx.example_01076
policy deterministic
policy no_network
effect Effect01076 {
  fluid Smoke { grid: [52,52,36] solver: stable_fluids }
  cloth Banner { resolution: [36,36] stiffness: 0.7 }
  destruction Debris { pieces: 60 fracture: voronoi seed: 1076 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.5 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
