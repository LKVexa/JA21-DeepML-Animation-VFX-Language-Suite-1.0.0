deepml vfx 0.3
module corpus.deepml_vfx.example_02547
policy deterministic
policy no_network
effect Effect02547 {
  coupled simulation PortalSim seed 2547 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache6 interval 0s..10s step 1/60s hash sha256("cache:02547")
  bind scene PortalScene14
  bind timeline PortalSequence12
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
