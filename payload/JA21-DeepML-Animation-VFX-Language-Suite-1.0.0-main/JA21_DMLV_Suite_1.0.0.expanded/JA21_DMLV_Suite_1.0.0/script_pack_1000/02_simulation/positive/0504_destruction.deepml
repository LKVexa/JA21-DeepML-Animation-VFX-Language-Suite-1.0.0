deepml vfx 0.3
module corpus.deepml_vfx.example_01185
policy deterministic
policy no_network
effect Effect01185 {
  fluid Smoke { grid: [65,65,49] solver: stable_fluids }
  cloth Banner { resolution: [17,17] stiffness: 0.4 }
  destruction Debris { pieces: 41 fracture: voronoi seed: 1185 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.2 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
