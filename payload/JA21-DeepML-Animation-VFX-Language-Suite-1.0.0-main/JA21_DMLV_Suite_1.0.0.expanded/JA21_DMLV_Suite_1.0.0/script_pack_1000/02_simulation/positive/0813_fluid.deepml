deepml vfx 0.3
module corpus.deepml_vfx.example_01223
policy deterministic
policy no_network
effect Effect01223 {
  fluid Smoke { grid: [103,103,39] solver: stable_fluids }
  cloth Banner { resolution: [23,23] stiffness: 0.7 }
  destruction Debris { pieces: 15 fracture: voronoi seed: 1223 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.8 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
