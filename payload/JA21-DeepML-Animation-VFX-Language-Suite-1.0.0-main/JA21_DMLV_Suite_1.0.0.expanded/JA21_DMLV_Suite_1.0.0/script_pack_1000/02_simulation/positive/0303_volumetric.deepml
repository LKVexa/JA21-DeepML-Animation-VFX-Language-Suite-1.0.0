deepml vfx 0.3
module corpus.deepml_vfx.example_01066
policy deterministic
policy no_network
effect Effect01066 {
  fluid Smoke { grid: [42,42,26] solver: stable_fluids }
  cloth Banner { resolution: [26,26] stiffness: 0.4 }
  destruction Debris { pieces: 50 fracture: voronoi seed: 1066 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.3 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
