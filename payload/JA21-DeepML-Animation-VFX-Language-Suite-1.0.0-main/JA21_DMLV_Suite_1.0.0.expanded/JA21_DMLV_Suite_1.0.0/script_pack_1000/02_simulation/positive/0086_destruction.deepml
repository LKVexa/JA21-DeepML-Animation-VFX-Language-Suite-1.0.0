deepml vfx 0.3
module corpus.deepml_vfx.example_01041
policy deterministic
policy no_network
effect Effect01041 {
  fluid Smoke { grid: [113,113,49] solver: stable_fluids }
  cloth Banner { resolution: [33,33] stiffness: 0.7 }
  destruction Debris { pieces: 25 fracture: voronoi seed: 1041 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.2 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
