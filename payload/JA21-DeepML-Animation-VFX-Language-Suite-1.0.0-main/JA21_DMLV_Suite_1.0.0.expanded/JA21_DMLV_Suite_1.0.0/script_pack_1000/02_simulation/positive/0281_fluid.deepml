deepml vfx 0.3
module corpus.deepml_vfx.example_01070
policy deterministic
policy no_network
effect Effect01070 {
  fluid Smoke { grid: [46,46,30] solver: stable_fluids }
  cloth Banner { resolution: [30,30] stiffness: 0.8 }
  destruction Debris { pieces: 54 fracture: voronoi seed: 1070 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.7 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
