deepml vfx 0.3
module corpus.deepml_vfx.example_01129
policy deterministic
policy no_network
effect Effect01129 {
  fluid Smoke { grid: [105,105,41] solver: stable_fluids }
  cloth Banner { resolution: [25,25] stiffness: 0.4 }
  destruction Debris { pieces: 49 fracture: voronoi seed: 1129 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.2 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
