deepml vfx 0.3
module corpus.deepml_vfx.example_02607
policy deterministic
policy no_network
effect Effect02607 {
  coupled simulation PortalSim seed 2607 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache0 interval 0s..10s step 1/60s hash sha256("cache:02607")
  bind scene PortalScene6
  bind timeline PortalSequence7
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
