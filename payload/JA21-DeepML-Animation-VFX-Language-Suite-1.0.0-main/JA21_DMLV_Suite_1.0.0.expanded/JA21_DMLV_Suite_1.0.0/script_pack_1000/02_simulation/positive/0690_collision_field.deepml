deepml vfx 0.3
module corpus.deepml_vfx.example_01202
policy deterministic
policy no_network
effect Effect01202 {
  fluid Smoke { grid: [82,82,18] solver: stable_fluids }
  cloth Banner { resolution: [34,34] stiffness: 0.7 }
  destruction Debris { pieces: 58 fracture: voronoi seed: 1202 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.3 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
