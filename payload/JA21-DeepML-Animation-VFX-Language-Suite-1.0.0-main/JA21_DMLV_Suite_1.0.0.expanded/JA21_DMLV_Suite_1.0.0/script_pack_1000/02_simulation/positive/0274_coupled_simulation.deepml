deepml vfx 0.3
module corpus.deepml_vfx.example_02553
policy deterministic
policy no_network
effect Effect02553 {
  coupled simulation PortalSim seed 2553 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache1 interval 0s..10s step 1/60s hash sha256("cache:02553")
  bind scene PortalScene3
  bind timeline PortalSequence5
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
