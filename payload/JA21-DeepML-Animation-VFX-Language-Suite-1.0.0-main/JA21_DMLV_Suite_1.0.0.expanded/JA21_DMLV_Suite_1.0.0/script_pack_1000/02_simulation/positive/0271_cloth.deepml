deepml vfx 0.3
module corpus.deepml_vfx.example_01087
policy deterministic
policy no_network
effect Effect01087 {
  fluid Smoke { grid: [63,63,47] solver: stable_fluids }
  cloth Banner { resolution: [47,47] stiffness: 0.4 }
  destruction Debris { pieces: 71 fracture: voronoi seed: 1087 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.8 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
