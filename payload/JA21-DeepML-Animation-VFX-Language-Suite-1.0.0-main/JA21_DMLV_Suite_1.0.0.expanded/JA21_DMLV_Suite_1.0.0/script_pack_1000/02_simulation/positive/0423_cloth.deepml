deepml vfx 0.3
module corpus.deepml_vfx.example_01141
policy deterministic
policy no_network
effect Effect01141 {
  fluid Smoke { grid: [117,117,53] solver: stable_fluids }
  cloth Banner { resolution: [37,37] stiffness: 0.2 }
  destruction Debris { pieces: 61 fracture: voronoi seed: 1141 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.6 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
