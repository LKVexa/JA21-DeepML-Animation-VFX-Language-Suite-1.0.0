deepml vfx 0.3
module corpus.deepml_vfx.example_01192
policy deterministic
policy no_network
effect Effect01192 {
  fluid Smoke { grid: [72,72,56] solver: stable_fluids }
  cloth Banner { resolution: [24,24] stiffness: 0.4 }
  destruction Debris { pieces: 48 fracture: voronoi seed: 1192 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.1 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
