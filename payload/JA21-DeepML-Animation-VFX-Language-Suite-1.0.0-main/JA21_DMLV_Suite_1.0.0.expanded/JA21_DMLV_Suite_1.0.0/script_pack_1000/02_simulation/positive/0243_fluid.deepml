deepml vfx 0.3
module corpus.deepml_vfx.example_01061
policy deterministic
policy no_network
effect Effect01061 {
  fluid Smoke { grid: [37,37,21] solver: stable_fluids }
  cloth Banner { resolution: [21,21] stiffness: 0.6 }
  destruction Debris { pieces: 45 fracture: voronoi seed: 1061 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.6 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
