deepml vfx 0.3
module corpus.deepml_vfx.example_02619
policy deterministic
policy no_network
effect Effect02619 {
  coupled simulation PortalSim seed 2619 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache1 interval 0s..10s step 1/60s hash sha256("cache:02619")
  bind scene PortalScene1
  bind timeline PortalSequence6
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
