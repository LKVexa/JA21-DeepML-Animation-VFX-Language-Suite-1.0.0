deepml vfx 0.3
module corpus.deepml_vfx.example_05099
policy deterministic
policy no_network
vfx_package Effect05099 {
  weather system Weather3 { wind: vec3(2,0,1) rain: 699/s }
  destruction sequence Collapse4 bind timeline.Destruction
  interaction fluid Smoke with cloth Banner collision two_way
  portal effect Portal5 { particles: Sparks volumetric: Fog shader: Distortion }
  lighting pipeline { key: Sun fill: PortalGlow exposure: auto_deterministic }
  compositing pipeline { passes: [Scene, Weather, Portal, Grade] }
}
package vfx Effect05099 as "vfx_05099.msslb"
assert render_hash == "invalid-05099"
