deepml vfx 0.3
module corpus.deepml_vfx.example_02540
policy deterministic
policy no_network
effect Effect02540 {
  coupled simulation PortalSim seed 2540 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache10 interval 0s..10s step 1/60s hash sha256("cache:02540")
  bind scene PortalScene7
  bind timeline PortalSequence5
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
assert render_hash == "invalid-02540"
