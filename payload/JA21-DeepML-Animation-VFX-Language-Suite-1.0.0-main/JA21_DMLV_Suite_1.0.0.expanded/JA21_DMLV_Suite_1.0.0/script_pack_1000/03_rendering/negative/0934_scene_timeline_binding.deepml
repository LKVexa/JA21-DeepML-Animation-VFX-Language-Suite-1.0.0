deepml vfx 0.3
module corpus.deepml_vfx.example_02556
policy deterministic
policy no_network
effect Effect02556 {
  coupled simulation PortalSim seed 2556 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache4 interval 0s..10s step 1/60s hash sha256("cache:02556")
  bind scene PortalScene6
  bind timeline PortalSequence8
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
assert render_hash == "invalid-02556"
