deepml vfx 0.3
module corpus.deepml_vfx.example_02602
policy deterministic
policy no_network
effect Effect02602 {
  coupled simulation PortalSim seed 2602 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache6 interval 0s..10s step 1/60s hash sha256("cache:02602")
  bind scene PortalScene1
  bind timeline PortalSequence2
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
assert render_hash == "invalid-02602"
