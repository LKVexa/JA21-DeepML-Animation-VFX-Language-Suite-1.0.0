deepml vfx 0.3
module corpus.deepml_vfx.example_01055
policy deterministic
policy no_network
effect Effect01055 {
  fluid Smoke { grid: [127,127,63] solver: stable_fluids }
  cloth Banner { resolution: [47,47] stiffness: 0.7 }
  destruction Debris { pieces: 39 fracture: voronoi seed: 1055 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.8 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
