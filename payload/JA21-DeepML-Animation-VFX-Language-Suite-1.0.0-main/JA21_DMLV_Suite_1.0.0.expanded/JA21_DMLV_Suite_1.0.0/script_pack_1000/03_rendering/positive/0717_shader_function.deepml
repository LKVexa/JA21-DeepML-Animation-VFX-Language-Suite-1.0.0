deepml vfx 0.3
module corpus.deepml_vfx.example_01163
policy deterministic
policy no_network
effect Effect01163 {
  fluid Smoke { grid: [43,43,27] solver: stable_fluids }
  cloth Banner { resolution: [27,27] stiffness: 0.3 }
  destruction Debris { pieces: 19 fracture: voronoi seed: 1163 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.4 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
