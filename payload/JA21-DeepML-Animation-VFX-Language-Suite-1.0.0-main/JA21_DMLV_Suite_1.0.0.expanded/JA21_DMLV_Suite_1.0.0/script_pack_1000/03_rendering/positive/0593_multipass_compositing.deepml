deepml vfx 0.3
module corpus.deepml_vfx.example_02608
policy deterministic
policy no_network
effect Effect02608 {
  coupled simulation PortalSim seed 2608 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache1 interval 0s..10s step 1/60s hash sha256("cache:02608")
  bind scene PortalScene7
  bind timeline PortalSequence8
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
