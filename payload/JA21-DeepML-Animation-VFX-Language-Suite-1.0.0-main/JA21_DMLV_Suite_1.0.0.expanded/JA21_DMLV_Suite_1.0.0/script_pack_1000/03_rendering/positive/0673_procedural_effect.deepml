deepml vfx 0.3
module corpus.deepml_vfx.example_02630
policy deterministic
policy no_network
effect Effect02630 {
  coupled simulation PortalSim seed 2630 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache1 interval 0s..10s step 1/60s hash sha256("cache:02630")
  bind scene PortalScene12
  bind timeline PortalSequence4
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
