deepml vfx 0.3
module corpus.deepml_vfx.example_02566
policy deterministic
policy no_network
effect Effect02566 {
  coupled simulation PortalSim seed 2566 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache3 interval 0s..10s step 1/60s hash sha256("cache:02566")
  bind scene PortalScene16
  bind timeline PortalSequence5
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
