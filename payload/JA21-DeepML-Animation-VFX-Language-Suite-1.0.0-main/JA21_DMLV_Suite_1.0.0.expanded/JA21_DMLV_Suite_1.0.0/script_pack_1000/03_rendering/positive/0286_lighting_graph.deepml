deepml vfx 0.3
module corpus.deepml_vfx.example_01065
policy deterministic
policy no_network
effect Effect01065 {
  fluid Smoke { grid: [41,41,25] solver: stable_fluids }
  cloth Banner { resolution: [25,25] stiffness: 0.3 }
  destruction Debris { pieces: 49 fracture: voronoi seed: 1065 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.2 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
