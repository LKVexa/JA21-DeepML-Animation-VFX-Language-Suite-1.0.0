deepml vfx 0.3
module corpus.deepml_vfx.example_05124
policy deterministic
policy no_network
vfx_package Effect05124 {
  weather system Weather0 { wind: vec3(2,0,1) rain: 724/s }
  destruction sequence Collapse4 bind timeline.Destruction
  interaction fluid Smoke with cloth Banner collision two_way
  portal effect Portal3 { particles: Sparks volumetric: Fog shader: Distortion }
  lighting pipeline { key: Sun fill: PortalGlow exposure: auto_deterministic }
  compositing pipeline { passes: [Scene, Weather, Portal, Grade] }
}
package vfx Effect05124 as "vfx_05124.msslb"
