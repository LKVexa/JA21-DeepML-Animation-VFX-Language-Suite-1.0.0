deepml vfx 0.3
module corpus.deepml_vfx.example_02606
policy deterministic
policy no_network
effect Effect02606 {
  coupled simulation PortalSim seed 2606 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache10 interval 0s..10s step 1/60s hash sha256("cache:02606")
  bind scene PortalScene5
  bind timeline PortalSequence6
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
