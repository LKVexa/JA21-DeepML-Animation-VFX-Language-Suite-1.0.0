deepml vfx 0.3
module corpus.deepml_vfx.example_01119
policy deterministic
policy no_network
effect Effect01119 {
  fluid Smoke { grid: [95,95,31] solver: stable_fluids }
  cloth Banner { resolution: [47,47] stiffness: 0.8 }
  destruction Debris { pieces: 39 fracture: voronoi seed: 1119 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.8 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
