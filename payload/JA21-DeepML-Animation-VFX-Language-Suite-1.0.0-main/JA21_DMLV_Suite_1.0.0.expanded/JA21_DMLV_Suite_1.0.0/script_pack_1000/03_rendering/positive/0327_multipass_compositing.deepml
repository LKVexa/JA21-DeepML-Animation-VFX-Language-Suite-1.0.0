deepml vfx 0.3
module corpus.deepml_vfx.example_02560
policy deterministic
policy no_network
effect Effect02560 {
  coupled simulation PortalSim seed 2560 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache8 interval 0s..10s step 1/60s hash sha256("cache:02560")
  bind scene PortalScene10
  bind timeline PortalSequence12
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
