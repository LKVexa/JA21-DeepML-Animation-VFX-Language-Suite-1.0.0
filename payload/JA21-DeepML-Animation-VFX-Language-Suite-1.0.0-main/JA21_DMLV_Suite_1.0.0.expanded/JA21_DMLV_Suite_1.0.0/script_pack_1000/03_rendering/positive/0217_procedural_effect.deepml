deepml vfx 0.3
module corpus.deepml_vfx.example_02546
policy deterministic
policy no_network
effect Effect02546 {
  coupled simulation PortalSim seed 2546 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache5 interval 0s..10s step 1/60s hash sha256("cache:02546")
  bind scene PortalScene13
  bind timeline PortalSequence11
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
