deepml vfx 0.3
module corpus.deepml_vfx.example_02596
policy deterministic
policy no_network
effect Effect02596 {
  coupled simulation PortalSim seed 2596 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache0 interval 0s..10s step 1/60s hash sha256("cache:02596")
  bind scene PortalScene12
  bind timeline PortalSequence9
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
