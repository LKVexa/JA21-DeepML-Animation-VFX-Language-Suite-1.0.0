deepml vfx 0.3
module corpus.deepml_vfx.example_02624
policy deterministic
policy no_network
effect Effect02624 {
  coupled simulation PortalSim seed 2624 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache6 interval 0s..10s step 1/60s hash sha256("cache:02624")
  bind scene PortalScene6
  bind timeline PortalSequence11
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
