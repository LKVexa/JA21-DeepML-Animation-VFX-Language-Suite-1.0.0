deepml vfx 0.3
module corpus.deepml_vfx.example_02532
policy deterministic
policy no_network
effect Effect02532 {
  coupled simulation PortalSim seed 2532 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache2 interval 0s..10s step 1/60s hash sha256("cache:02532")
  bind scene PortalScene16
  bind timeline PortalSequence10
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
