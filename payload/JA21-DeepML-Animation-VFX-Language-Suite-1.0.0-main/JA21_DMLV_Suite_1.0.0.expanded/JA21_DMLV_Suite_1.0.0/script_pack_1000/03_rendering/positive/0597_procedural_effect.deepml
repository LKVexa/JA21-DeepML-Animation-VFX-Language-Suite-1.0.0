deepml vfx 0.3
module corpus.deepml_vfx.example_02618
policy deterministic
policy no_network
effect Effect02618 {
  coupled simulation PortalSim seed 2618 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache0 interval 0s..10s step 1/60s hash sha256("cache:02618")
  bind scene PortalScene0
  bind timeline PortalSequence5
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
