deepml vfx 0.3
module corpus.deepml_vfx.example_01109
policy deterministic
policy no_network
effect Effect01109 {
  fluid Smoke { grid: [85,85,21] solver: stable_fluids }
  cloth Banner { resolution: [37,37] stiffness: 0.5 }
  destruction Debris { pieces: 29 fracture: voronoi seed: 1109 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.6 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
