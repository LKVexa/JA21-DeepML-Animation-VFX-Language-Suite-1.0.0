deepml vfx 0.3
module corpus.deepml_vfx.example_01155
policy deterministic
policy no_network
effect Effect01155 {
  fluid Smoke { grid: [35,35,19] solver: stable_fluids }
  cloth Banner { resolution: [19,19] stiffness: 0.2 }
  destruction Debris { pieces: 11 fracture: voronoi seed: 1155 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.4 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
