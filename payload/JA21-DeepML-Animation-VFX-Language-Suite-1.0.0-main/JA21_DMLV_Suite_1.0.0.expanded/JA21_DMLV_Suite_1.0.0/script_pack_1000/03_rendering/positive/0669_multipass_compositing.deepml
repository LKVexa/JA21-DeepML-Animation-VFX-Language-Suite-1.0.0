deepml vfx 0.3
module corpus.deepml_vfx.example_02620
policy deterministic
policy no_network
effect Effect02620 {
  coupled simulation PortalSim seed 2620 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache2 interval 0s..10s step 1/60s hash sha256("cache:02620")
  bind scene PortalScene2
  bind timeline PortalSequence7
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
