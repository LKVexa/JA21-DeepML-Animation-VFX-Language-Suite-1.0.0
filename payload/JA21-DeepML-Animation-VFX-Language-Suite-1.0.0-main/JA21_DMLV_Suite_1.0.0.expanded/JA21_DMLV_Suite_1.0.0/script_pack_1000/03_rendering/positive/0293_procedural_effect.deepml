deepml vfx 0.3
module corpus.deepml_vfx.example_02558
policy deterministic
policy no_network
effect Effect02558 {
  coupled simulation PortalSim seed 2558 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache6 interval 0s..10s step 1/60s hash sha256("cache:02558")
  bind scene PortalScene8
  bind timeline PortalSequence10
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
