deepml vfx 0.3
module corpus.deepml_vfx.example_01136
policy deterministic
policy no_network
effect Effect01136 {
  fluid Smoke { grid: [112,112,48] solver: stable_fluids }
  cloth Banner { resolution: [32,32] stiffness: 0.4 }
  destruction Debris { pieces: 56 fracture: voronoi seed: 1136 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.1 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
