deepml vfx 0.3
module corpus.deepml_vfx.example_02598
policy deterministic
policy no_network
effect Effect02598 {
  coupled simulation PortalSim seed 2598 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache2 interval 0s..10s step 1/60s hash sha256("cache:02598")
  bind scene PortalScene14
  bind timeline PortalSequence11
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
