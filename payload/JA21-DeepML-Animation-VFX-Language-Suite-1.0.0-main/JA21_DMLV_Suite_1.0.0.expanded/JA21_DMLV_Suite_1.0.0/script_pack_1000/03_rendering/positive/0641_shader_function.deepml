deepml vfx 0.3
module corpus.deepml_vfx.example_01145
policy deterministic
policy no_network
effect Effect01145 {
  fluid Smoke { grid: [121,121,57] solver: stable_fluids }
  cloth Banner { resolution: [41,41] stiffness: 0.6 }
  destruction Debris { pieces: 65 fracture: voronoi seed: 1145 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.2 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
