deepml vfx 0.3
module corpus.deepml_vfx.example_02614
policy deterministic
policy no_network
effect Effect02614 {
  coupled simulation PortalSim seed 2614 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache7 interval 0s..10s step 1/60s hash sha256("cache:02614")
  bind scene PortalScene13
  bind timeline PortalSequence1
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
