deepml vfx 0.3
module corpus.deepml_vfx.example_02524
policy deterministic
policy no_network
effect Effect02524 {
  coupled simulation PortalSim seed 2524 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache5 interval 0s..10s step 1/60s hash sha256("cache:02524")
  bind scene PortalScene8
  bind timeline PortalSequence2
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
