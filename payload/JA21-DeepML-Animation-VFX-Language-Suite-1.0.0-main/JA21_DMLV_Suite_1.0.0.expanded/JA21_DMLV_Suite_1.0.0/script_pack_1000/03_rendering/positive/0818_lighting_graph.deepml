deepml vfx 0.3
module corpus.deepml_vfx.example_01191
policy deterministic
policy no_network
effect Effect01191 {
  fluid Smoke { grid: [71,71,55] solver: stable_fluids }
  cloth Banner { resolution: [23,23] stiffness: 0.3 }
  destruction Debris { pieces: 47 fracture: voronoi seed: 1191 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.8 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
