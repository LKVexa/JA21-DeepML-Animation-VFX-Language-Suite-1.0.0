deepml vfx 0.3
module corpus.deepml_vfx.example_01037
policy deterministic
policy no_network
effect Effect01037 {
  fluid Smoke { grid: [109,109,45] solver: stable_fluids }
  cloth Banner { resolution: [29,29] stiffness: 0.3 }
  destruction Debris { pieces: 21 fracture: voronoi seed: 1037 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.6 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
