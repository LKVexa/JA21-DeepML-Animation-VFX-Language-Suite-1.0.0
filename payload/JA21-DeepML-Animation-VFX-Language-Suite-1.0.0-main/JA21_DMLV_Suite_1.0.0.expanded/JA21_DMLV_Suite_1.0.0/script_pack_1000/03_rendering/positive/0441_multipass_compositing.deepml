deepml vfx 0.3
module corpus.deepml_vfx.example_02578
policy deterministic
policy no_network
effect Effect02578 {
  coupled simulation PortalSim seed 2578 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache4 interval 0s..10s step 1/60s hash sha256("cache:02578")
  bind scene PortalScene11
  bind timeline PortalSequence4
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
