deepml vfx 0.3
module corpus.deepml_vfx.example_01082
policy deterministic
policy no_network
effect Effect01082 {
  fluid Smoke { grid: [58,58,42] solver: stable_fluids }
  cloth Banner { resolution: [42,42] stiffness: 0.6 }
  destruction Debris { pieces: 66 fracture: voronoi seed: 1082 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.3 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
