deepml vfx 0.3
module corpus.deepml_vfx.example_02528
policy deterministic
policy no_network
effect Effect02528 {
  coupled simulation PortalSim seed 2528 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache9 interval 0s..10s step 1/60s hash sha256("cache:02528")
  bind scene PortalScene12
  bind timeline PortalSequence6
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
