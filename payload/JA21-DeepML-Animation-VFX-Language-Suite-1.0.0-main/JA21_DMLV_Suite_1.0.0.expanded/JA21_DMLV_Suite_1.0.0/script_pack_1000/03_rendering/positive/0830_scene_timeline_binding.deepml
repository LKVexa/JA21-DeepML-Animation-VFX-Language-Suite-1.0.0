deepml vfx 0.3
module corpus.deepml_vfx.example_02652
policy deterministic
policy no_network
effect Effect02652 {
  coupled simulation PortalSim seed 2652 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache1 interval 0s..10s step 1/60s hash sha256("cache:02652")
  bind scene PortalScene0
  bind timeline PortalSequence0
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
