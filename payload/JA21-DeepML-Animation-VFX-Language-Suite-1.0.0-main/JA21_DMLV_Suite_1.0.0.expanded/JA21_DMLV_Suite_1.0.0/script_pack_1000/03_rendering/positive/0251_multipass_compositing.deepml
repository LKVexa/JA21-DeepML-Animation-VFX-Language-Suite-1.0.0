deepml vfx 0.3
module corpus.deepml_vfx.example_02542
policy deterministic
policy no_network
effect Effect02542 {
  coupled simulation PortalSim seed 2542 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache1 interval 0s..10s step 1/60s hash sha256("cache:02542")
  bind scene PortalScene9
  bind timeline PortalSequence7
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
