deepml vfx 0.3
module corpus.deepml_vfx.example_02522
policy deterministic
policy no_network
effect Effect02522 {
  coupled simulation PortalSim seed 2522 { fluid: Energy cloth: Veil particles: Sparks }
  procedural operator Distort(time, portal_state) differentiable
  cache PortalCache3 interval 0s..10s step 1/60s hash sha256("cache:02522")
  bind scene PortalScene6
  bind timeline PortalSequence0
  render_graph { Sim -> Lighting -> Distortion -> Composite }
  composite multipass [SceneColor, PortalGlow, Distortion, Atmosphere]
}
