deepml vfx 0.3
module corpus.deepml_vfx.example_01116
policy deterministic
policy no_network
effect Effect01116 {
  fluid Smoke { grid: [92,92,28] solver: stable_fluids }
  cloth Banner { resolution: [44,44] stiffness: 0.5 }
  destruction Debris { pieces: 36 fracture: voronoi seed: 1116 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.5 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
