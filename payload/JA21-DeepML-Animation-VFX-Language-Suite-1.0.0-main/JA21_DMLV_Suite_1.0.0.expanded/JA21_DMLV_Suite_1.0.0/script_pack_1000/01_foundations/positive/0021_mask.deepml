deepml vfx 0.3
module corpus.deepml_vfx.example_01008
policy deterministic
policy no_network
effect Effect01008 {
  fluid Smoke { grid: [80,80,16] solver: stable_fluids }
  cloth Banner { resolution: [32,32] stiffness: 0.2 }
  destruction Debris { pieces: 56 fracture: voronoi seed: 1008 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.1 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
