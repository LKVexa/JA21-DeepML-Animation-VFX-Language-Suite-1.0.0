deepml vfx 0.3
module corpus.deepml_vfx.example_01090
policy deterministic
policy no_network
effect Effect01090 {
  fluid Smoke { grid: [66,66,50] solver: stable_fluids }
  cloth Banner { resolution: [18,18] stiffness: 0.7 }
  destruction Debris { pieces: 10 fracture: voronoi seed: 1090 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.3 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
