deepml vfx 0.3
module corpus.deepml_vfx.example_01071
policy deterministic
policy no_network
effect Effect01071 {
  fluid Smoke { grid: [47,47,31] solver: stable_fluids }
  cloth Banner { resolution: [31,31] stiffness: 0.2 }
  destruction Debris { pieces: 55 fracture: voronoi seed: 1071 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.8 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
