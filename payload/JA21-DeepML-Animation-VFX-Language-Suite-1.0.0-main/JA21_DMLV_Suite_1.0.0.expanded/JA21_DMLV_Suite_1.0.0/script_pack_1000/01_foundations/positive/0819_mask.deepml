deepml vfx 0.3
module corpus.deepml_vfx.example_01197
policy deterministic
policy no_network
effect Effect01197 {
  fluid Smoke { grid: [77,77,61] solver: stable_fluids }
  cloth Banner { resolution: [29,29] stiffness: 0.2 }
  destruction Debris { pieces: 53 fracture: voronoi seed: 1197 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.6 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
