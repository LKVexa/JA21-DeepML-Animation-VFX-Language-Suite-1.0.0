deepml vfx 0.3
module corpus.deepml_vfx.example_01045
policy deterministic
policy no_network
effect Effect01045 {
  fluid Smoke { grid: [117,117,53] solver: stable_fluids }
  cloth Banner { resolution: [37,37] stiffness: 0.4 }
  destruction Debris { pieces: 29 fracture: voronoi seed: 1045 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.6 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
