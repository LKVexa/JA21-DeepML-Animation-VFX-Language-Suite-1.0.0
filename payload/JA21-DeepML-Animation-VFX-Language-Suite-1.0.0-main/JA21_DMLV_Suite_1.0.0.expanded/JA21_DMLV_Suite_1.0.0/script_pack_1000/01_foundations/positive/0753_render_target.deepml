deepml vfx 0.3
module corpus.deepml_vfx.example_01180
policy deterministic
policy no_network
effect Effect01180 {
  fluid Smoke { grid: [60,60,44] solver: stable_fluids }
  cloth Banner { resolution: [44,44] stiffness: 0.6 }
  destruction Debris { pieces: 36 fracture: voronoi seed: 1180 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.5 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
