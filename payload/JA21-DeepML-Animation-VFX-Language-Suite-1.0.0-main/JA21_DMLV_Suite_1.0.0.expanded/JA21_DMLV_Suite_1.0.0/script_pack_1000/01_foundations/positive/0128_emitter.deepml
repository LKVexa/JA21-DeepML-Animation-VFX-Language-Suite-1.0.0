deepml vfx 0.3
module corpus.deepml_vfx.example_00030
policy deterministic
policy no_network
particle_system Effect00030 {
  emitter Main rate 40/s lifetime 7s seed 30
  attribute position: vec3
  attribute velocity: vec3
  force gravity vec3(0,-9.81,0)
  shader node ColorOverLife { input age output color }
