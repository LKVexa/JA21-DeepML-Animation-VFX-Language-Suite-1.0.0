deepml vfx 0.3
module corpus.deepml_vfx.example_00015
policy deterministic
policy no_network
particle_system Effect00015 {
  emitter Main rate 25/s lifetime 8s seed 15
  attribute position: vec3
  attribute velocity: vec3
  force gravity vec3(0,-9.81,0)
  shader node ColorOverLife { input age output color }
  material PortalMat { shader: ColorOverLife blend: additive }
  light Glow { intensity: 1.8 color: rgb(0.2,0.5,1.0) }
}
render_pass MainPass inputs [Effect00015] target Color
composite Color over SceneColor
