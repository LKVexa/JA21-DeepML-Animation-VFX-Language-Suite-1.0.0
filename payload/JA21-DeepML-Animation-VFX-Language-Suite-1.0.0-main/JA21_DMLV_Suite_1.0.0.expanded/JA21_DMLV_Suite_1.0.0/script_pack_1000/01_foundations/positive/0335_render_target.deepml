deepml vfx 0.3
module corpus.deepml_vfx.example_01081
policy deterministic
policy no_network
effect Effect01081 {
  fluid Smoke { grid: [57,57,41] solver: stable_fluids }
  cloth Banner { resolution: [41,41] stiffness: 0.5 }
  destruction Debris { pieces: 65 fracture: voronoi seed: 1081 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.2 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
