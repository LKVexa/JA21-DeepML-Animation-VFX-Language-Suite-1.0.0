deepml vfx 0.3
module corpus.deepml_vfx.example_01153
policy deterministic
policy no_network
effect Effect01153 {
  fluid Smoke { grid: [33,33,17] solver: stable_fluids }
  cloth Banner { resolution: [17,17] stiffness: 0.7 }
  destruction Debris { pieces: 9 fracture: voronoi seed: 1153 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.2 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
