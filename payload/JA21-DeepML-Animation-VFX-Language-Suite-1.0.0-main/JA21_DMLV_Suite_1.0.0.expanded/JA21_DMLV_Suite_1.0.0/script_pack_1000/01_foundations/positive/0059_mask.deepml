deepml vfx 0.3
module corpus.deepml_vfx.example_01017
policy deterministic
policy no_network
effect Effect01017 {
  fluid Smoke { grid: [89,89,25] solver: stable_fluids }
  cloth Banner { resolution: [41,41] stiffness: 0.4 }
  destruction Debris { pieces: 65 fracture: voronoi seed: 1017 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.2 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
