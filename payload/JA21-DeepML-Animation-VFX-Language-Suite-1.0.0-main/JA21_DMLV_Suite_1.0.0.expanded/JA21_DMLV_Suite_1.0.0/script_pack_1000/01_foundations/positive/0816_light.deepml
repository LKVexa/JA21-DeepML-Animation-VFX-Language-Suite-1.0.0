deepml vfx 0.3
module corpus.deepml_vfx.example_00232
policy deterministic
policy no_network
particle_system Effect00232 {
  emitter Main rate 52/s lifetime 1s seed 232
  attribute position: vec3
  attribute velocity: vec3
  force gravity vec3(0,-9.81,0)
  shader node ColorOverLife { input age output color }
  material PortalMat { shader: ColorOverLife blend: additive }
  light Glow { intensity: 4.1 color: rgb(0.2,0.5,1.0) }
}
render_pass MainPass inputs [Effect00232] target Color
composite Color over SceneColor
