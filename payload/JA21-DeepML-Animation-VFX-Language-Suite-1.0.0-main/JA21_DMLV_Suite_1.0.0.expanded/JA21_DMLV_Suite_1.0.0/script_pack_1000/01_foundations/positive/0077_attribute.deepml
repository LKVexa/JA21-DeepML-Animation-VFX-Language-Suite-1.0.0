deepml vfx 0.3
module corpus.deepml_vfx.example_00020
policy deterministic
policy no_network
particle_system Effect00020 {
  emitter Main rate 30/s lifetime 5s seed 20
  attribute position: vec3
  attribute velocity: vec3
  force gravity vec3(0,-9.81,0)
  shader node ColorOverLife { input age output color }
  material PortalMat { shader: ColorOverLife blend: additive }
  light Glow { intensity: 2.3 color: rgb(0.2,0.5,1.0) }
}
render_pass MainPass inputs [Effect00020] target Color
composite Color over SceneColor
