deepml vfx 0.3
module corpus.deepml_vfx.example_00012
policy deterministic
policy no_network
particle_system Effect00012 {
  emitter Main rate 22/s lifetime 5s seed 12
  attribute position: vec3
  attribute velocity: vec3
  force gravity vec3(0,-9.81,0)
  shader node ColorOverLife { input age output color }
  material PortalMat { shader: ColorOverLife blend: additive }
  light Glow { intensity: 1.5 color: rgb(0.2,0.5,1.0) }
}
render_pass MainPass inputs [Effect00012] target Color
composite Color over SceneColor
