deepml vfx 0.3
module corpus.deepml_vfx.example_01135
policy deterministic
policy no_network
effect Effect01135 {
  fluid Smoke { grid: [111,111,47] solver: stable_fluids }
  cloth Banner { resolution: [31,31] stiffness: 0.3 }
  destruction Debris { pieces: 55 fracture: voronoi seed: 1135 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.8 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
