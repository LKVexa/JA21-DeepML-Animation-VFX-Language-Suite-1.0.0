deepml vfx 0.3
module corpus.deepml_vfx.example_01054
policy deterministic
policy no_network
effect Effect01054 {
  fluid Smoke { grid: [126,126,62] solver: stable_fluids }
  cloth Banner { resolution: [46,46] stiffness: 0.6 }
  destruction Debris { pieces: 38 fracture: voronoi seed: 1054 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.7 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
