deepml vfx 0.3
module corpus.deepml_vfx.example_00050
policy deterministic
policy no_network
particle_system Effect00050 {
  emitter Main rate 60/s lifetime 3s seed 50
  attribute position: vec3
  attribute velocity: vec3
  force gravity vec3(0,-9.81,0)
  shader node ColorOverLife { input age output color }
  material PortalMat { shader: ColorOverLife blend: additive }
  light Glow { intensity: 5.3 color: rgb(0.2,0.5,1.0) }
}
render_pass MainPass inputs [Effect00050] target Color
composite Color over SceneColor
