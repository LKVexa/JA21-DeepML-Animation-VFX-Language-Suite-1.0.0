deepml vfx 0.3
module corpus.deepml_vfx.example_01189
policy deterministic
policy no_network
effect Effect01189 {
  fluid Smoke { grid: [69,69,53] solver: stable_fluids }
  cloth Banner { resolution: [21,21] stiffness: 0.8 }
  destruction Debris { pieces: 45 fracture: voronoi seed: 1189 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.6 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
