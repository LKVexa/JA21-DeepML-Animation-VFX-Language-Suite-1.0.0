deepml vfx 0.3
module corpus.deepml_vfx.example_01144
policy deterministic
policy no_network
effect Effect01144 {
  fluid Smoke { grid: [120,120,56] solver: stable_fluids }
  cloth Banner { resolution: [40,40] stiffness: 0.5 }
  destruction Debris { pieces: 64 fracture: voronoi seed: 1144 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.1 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
