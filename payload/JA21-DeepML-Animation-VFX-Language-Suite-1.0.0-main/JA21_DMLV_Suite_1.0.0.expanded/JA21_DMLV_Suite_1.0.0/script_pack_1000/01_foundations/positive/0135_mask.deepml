deepml vfx 0.3
module corpus.deepml_vfx.example_01035
policy deterministic
policy no_network
effect Effect01035 {
  fluid Smoke { grid: [107,107,43] solver: stable_fluids }
  cloth Banner { resolution: [27,27] stiffness: 0.8 }
  destruction Debris { pieces: 19 fracture: voronoi seed: 1035 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.4 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
