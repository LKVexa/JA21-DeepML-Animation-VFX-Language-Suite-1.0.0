deepml vfx 0.3
module corpus.deepml_vfx.example_01179
policy deterministic
policy no_network
effect Effect01179 {
  fluid Smoke { grid: [59,59,43] solver: stable_fluids }
  cloth Banner { resolution: [43,43] stiffness: 0.5 }
  destruction Debris { pieces: 35 fracture: voronoi seed: 1179 }
  collision_field WorldSDF source scene.Collider
  volumetric Fog { density: 0.4 }
  shader function ShadePortal(x: vec3) -> color
  render_target FXColor format rgba16f
  mask PortalMask source scene.PortalA
}
